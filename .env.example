# Copy to .env (or /etc/ngtraders.env on the server) and fill in. NEVER commit the real file.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=3600
# Behind Nginx (which sets X-Forwarded-For) so rate limits see the real visitor IP:
DJANGO_TRUST_XFF=1

# --- Database (PostgreSQL in production) ---
DB_ENGINE=postgres
DB_NAME=ngtraders
DB_USER=ngtraders
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Shop defaults (first run only; afterwards the owner edits "Shop settings" in the admin) ---
# Leave UPI empty and COD off until the owner confirms them.
SHOP_ADDRESS=
SHOP_UPI_ID=
SHOP_ENABLE_UPI=0
SHOP_DELIVERY_FEE=0
SHOP_ENABLE_COD=0
